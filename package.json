{
  "name": "html-lightweight-template-engine",
  "version": "2.0.0",
  "description": "Text interpolation and reusable templates for plain HTML pages.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "unpkg": "./dist/html-lightweight-template-engine.min.js",
  "jsdelivr": "./dist/html-lightweight-template-engine.min.js",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.js && tsc",
    "test": "node --test \"test/*.test.ts\"",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "npm-publish": "npm run lint && npm test && npm run build && npm publish"
  },
  "author": "Dato Marjanidze",
  "license": "ISC",
  "homepage": "https://github.com/davidmarjanidze/html-lightweight-template-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidmarjanidze/html-lightweight-template-engine.git"
  },
  "bugs": {
    "url": "https://github.com/davidmarjanidze/html-lightweight-template-engine/issues"
  },
  "keywords": [
    "html",
    "template",
    "template engine",
    "interpolation",
    "i18n"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^21.0.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
